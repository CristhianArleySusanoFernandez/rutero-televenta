# ============================================================
# Configuracion del Rutero Televenta
# Copiar este archivo como ".env" y llenar los valores reales.
# El archivo .env NUNCA se sube a Git (esta en .gitignore).
# ============================================================

# --- Supabase (obligatorio) ---------------------------------
# Panel de Supabase -> Project Settings -> API
SUPABASE_URL=
SUPABASE_KEY=

# --- Servidor (opcional, estos son los valores por defecto) -
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Telefono del asesor (opcional) -------------------------
# Id del telefono de este PC (Opcion A: un telefono por asesor).
# Si se deja vacio, el sistema usa el unico telefono conectado.
# Solo es obligatorio si hay VARIOS telefonos conectados al
# mismo servidor.
TELEFONO_ID=

# --- Groq / IA (opcional, funcionalidad descartada) ---------
# Se dejo la variable por compatibilidad; puede quedar vacia.
GROQ_API_KEY=
